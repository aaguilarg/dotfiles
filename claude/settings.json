  "model": "opus",
  "skillOverrides": {
    "hub-update": "off",
    "qa-recreate": "off",
    "vault-architecture": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/block-bare-rspec.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(\"$HOME\"/.local/bin/pr-review-digest --status 2>/dev/null) && [ -n \"$out\" ] && echo \"PR review status (pr-review-digest): $out\"; true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME\"/dotfiles/claude/statusline-with-pr.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "Notion@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "fast-jev-compaction@fast-jev-compaction": true,
    "claude-mermaid@claude-mods": true,
    "productivity@synced": false
  },
  "extraKnownMarketplaces": {
    "fast-jev-compaction": {
      "source": {
        "source": "github",
        "repo": "tamaratran/fast-jev-compaction"
      }
    },
    "claude-mods": {
      "source": {
        "source": "github",
        "repo": "galElmalah/claude-mods"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false
}
